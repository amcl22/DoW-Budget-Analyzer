// Cloudflare deployment: a small Worker in front of the app's Docker image (Cloudflare Containers).
// See deploy/cloudflare/README.md. Deploy from this directory with `npx wrangler deploy`
// (Docker must be running: wrangler builds the repo's Dockerfile and pushes it to Cloudflare).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dow-budget-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // don't publish the app on a *.workers.dev address as well as your own domain; set this to
  // true only until the custom domain below is in place
  "workers_dev": true,
  // "routes": [{ "pattern": "budget.example.com", "custom_domain": true }],
  "containers": [
    {
      "class_name": "BudgetApp",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB: plenty for serving; ingestion runs elsewhere (README)
      "instance_type": "basic",
      // one instance serves the team; the second covers rollouts
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "BudgetApp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetApp"] }],
  "vars": {
    // Q&A tuning (api/qa.py); leave empty for the defaults
    "QA_MODEL": "",
    "QA_EFFORT": "",
    "QA_MAX_PER_HOUR": "120"
  }
  // Secrets, set once with `npx wrangler secret put NAME` (never put them in this file):
  //   DATABASE_URL       postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
  //   ACCESS_TOKEN       from `budget new-access-token`
  //   ANTHROPIC_API_KEY  optional; turns on /ask
}
